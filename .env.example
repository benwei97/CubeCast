DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"

# Optional for Google sign-in. The local seed also creates demo credential users.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional for WCA sign-in. Create an OAuth application on the WCA website.
AUTH_WCA_ID=""
AUTH_WCA_SECRET=""

# Optional. Defaults to https://www.worldcubeassociation.org.
# Use https://staging.worldcubeassociation.org when testing against WCA staging.
WCA_BASE_URL=""
