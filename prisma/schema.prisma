generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum CompetitionStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELED
}

enum MarketStatus {
  DRAFT
  OPEN
  LOCKED
  CLOSED
  PENDING_RESULT
  RESOLVED
  VOID
  CANCELED
}

enum MarketCategory {
  WINNER
  PODIUM
  RECORD
  TIME_THRESHOLD
  HEAD_TO_HEAD
  ADVANCEMENT
  PLACEMENT
  PERFORMANCE
  OTHER
}

enum ContestSlateStatus {
  DRAFT
  OPEN
  LOCKED
  SETTLING
  FINALIZED
  CANCELLED
}

enum ContestEntryStatus {
  DRAFT
  VALID
  LOCKED
  FINALIZED
  INVALID
}

enum PredictionResultStatus {
  PENDING
  CORRECT
  INCORRECT
  VOID
  TIE
}

enum SettlementStatus {
  PENDING
  RESOLVED
  VOID
}

enum AdminActionType {
  SLATE_CREATE
  SLATE_UPDATE
  MARKET_CREATE
  MARKET_PUBLISH
  MARKET_VOID
  MARKET_SETTLE
  CONTEST_FINALIZE
  PRIZE_UPDATE
}

enum PrizeAwardStatus {
  DRAFT
  PENDING
  HELD
  APPROVED
  PAID
  CANCELLED
}

enum PayoutStatus {
  PENDING
  HELD
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

model User {
  id                  String               @id @default(cuid())
  name                String?
  email               String?              @unique
  emailVerified       DateTime?
  image               String?
  username            String               @unique @default(cuid())
  usernameLower       String               @unique @default(cuid())
  role                UserRole             @default(USER)
  passwordHash        String?
  accounts            Account[]
  sessions            Session[]
  wcaIdentity         WCAIdentity?
  createdMarkets      Market[]             @relation("CreatedMarkets")
  contestEntries      ContestEntry[]
  leaderboardEntries  LeaderboardEntry[]
  adminActions        AdminAction[]
  settlementSnapshots SettlementSnapshot[] @relation("SnapshotSettledBy")
  prizeAwards         PrizeAward[]
  payouts             Payout[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model WCAIdentity {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wcaUserId   String   @unique
  wcaId       String?  @unique
  name        String
  countryIso2 String?
  avatarUrl   String?
  profileUrl  String?
  rawProfile  Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Competition {
  id               String               @id @default(cuid())
  name             String
  slug             String               @unique
  description      String
  location         String
  country          String
  startDate        DateTime
  endDate          DateTime
  status           CompetitionStatus    @default(UPCOMING)
  imageUrl         String?
  officialUrl      String?
  wcaCompetitionId String?              @unique
  scheduledStartAt DateTime?
  scheduledEndAt   DateTime?
  sourceMetadata   Json?
  markets          Market[]
  contestSlates    ContestCompetition[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

model ContestSlate {
  id                 String               @id @default(cuid())
  title              String
  slug               String               @unique
  description        String
  status             ContestSlateStatus   @default(DRAFT)
  lockAt             DateTime
  startsAt           DateTime
  endsAt             DateTime
  publishedAt        DateTime?
  finalizedAt        DateTime?
  prizeEnabled       Boolean              @default(false)
  maxPicks           Int                  @default(10)
  baseScore          Int                  @default(1000)
  diversityConfig    Json?
  preparation        Json?
  competitions       ContestCompetition[]
  markets            Market[]
  entries            ContestEntry[]
  leaderboardEntries LeaderboardEntry[]
  adminActions       AdminAction[]
  prizeAwards        PrizeAward[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model ContestCompetition {
  id            String       @id @default(cuid())
  slateId       String
  slate         ContestSlate @relation(fields: [slateId], references: [id], onDelete: Cascade)
  competitionId String
  competition   Competition  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())

  @@unique([slateId, competitionId])
}

model Market {
  id                    String               @id @default(cuid())
  competitionId         String
  competition           Competition          @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  slateId               String?
  slate                 ContestSlate?        @relation(fields: [slateId], references: [id], onDelete: SetNull)
  question              String
  slug                  String               @unique
  description           String
  category              MarketCategory
  eventId               String?
  eventName             String?
  resolutionRules       String
  resolutionSource      String
  settlementRuleVersion String               @default("legacy")
  status                MarketStatus         @default(DRAFT)
  closeTime             DateTime
  lockAt                DateTime?
  publishedAt           DateTime?
  resolvedAt            DateTime?
  voidReason            String?
  createdByUserId       String
  createdBy             User                 @relation("CreatedMarkets", fields: [createdByUserId], references: [id])
  options               MarketOption[]
  predictions           Prediction[]
  settlementSnapshots   SettlementSnapshot[]
  adminActions          AdminAction[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
}

model MarketOption {
  id                  String               @id @default(cuid())
  marketId            String
  market              Market               @relation(fields: [marketId], references: [id], onDelete: Cascade)
  sideKey             String
  label               String
  probability         Int
  competitorWcaId     String?
  displayOrder        Int                  @default(0)
  predictions         Prediction[]
  settlementSnapshots SettlementSnapshot[] @relation("SnapshotWinningOption")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([marketId, sideKey])
}

model ContestEntry {
  id                        String             @id @default(cuid())
  userId                    String
  user                      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  slateId                   String
  slate                     ContestSlate       @relation(fields: [slateId], references: [id], onDelete: Cascade)
  status                    ContestEntryStatus @default(DRAFT)
  baseScore                 Int                @default(1000)
  lockedAt                  DateTime?
  finalizedAt               DateTime?
  finalScore                Int?
  correctCount              Int                @default(0)
  hardestCorrectProbability Int?
  predictions               Prediction[]
  leaderboardEntry          LeaderboardEntry?
  prizeAwards               PrizeAward[]
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  @@unique([userId, slateId])
}

model Prediction {
  id                     String                 @id @default(cuid())
  entryId                String
  entry                  ContestEntry           @relation(fields: [entryId], references: [id], onDelete: Cascade)
  marketId               String
  market                 Market                 @relation(fields: [marketId], references: [id], onDelete: Cascade)
  selectedMarketOptionId String
  selectedMarketOption   MarketOption           @relation(fields: [selectedMarketOptionId], references: [id], onDelete: Restrict)
  selectedProbability    Int
  resultStatus           PredictionResultStatus @default(PENDING)
  scoreChange            Int?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@unique([entryId, marketId])
}

model SettlementSnapshot {
  id                    String           @id @default(cuid())
  marketId              String
  market                Market           @relation(fields: [marketId], references: [id], onDelete: Cascade)
  status                SettlementStatus
  winningMarketOptionId String?
  winningMarketOption   MarketOption?    @relation("SnapshotWinningOption", fields: [winningMarketOptionId], references: [id], onDelete: SetNull)
  settledByUserId       String?
  settledBy             User?            @relation("SnapshotSettledBy", fields: [settledByUserId], references: [id], onDelete: SetNull)
  observedPublicationAt DateTime?
  settledAt             DateTime         @default(now())
  sourceUrl             String?
  sourceCompetitionId   String?
  sourceEventId         String?
  sourceRoundId         String?
  sourcePersonId        String?
  resultValue           String?
  placement             Int?
  ruleVersion           String
  snapshot              Json
  createdAt             DateTime         @default(now())
}

model LeaderboardEntry {
  id                        String       @id @default(cuid())
  slateId                   String
  slate                     ContestSlate @relation(fields: [slateId], references: [id], onDelete: Cascade)
  entryId                   String       @unique
  entry                     ContestEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  userId                    String
  user                      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rank                      Int
  finalScore                Int
  correctCount              Int
  hardestCorrectProbability Int?
  isSharedRank              Boolean      @default(false)
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  @@unique([slateId, userId])
}

model AdminAction {
  id          String          @id @default(cuid())
  adminUserId String
  adminUser   User            @relation(fields: [adminUserId], references: [id], onDelete: Restrict)
  actionType  AdminActionType
  slateId     String?
  slate       ContestSlate?   @relation(fields: [slateId], references: [id], onDelete: SetNull)
  marketId    String?
  market      Market?         @relation(fields: [marketId], references: [id], onDelete: SetNull)
  metadata    Json?
  createdAt   DateTime        @default(now())
}

model PrizeAward {
  id          String           @id @default(cuid())
  slateId     String
  slate       ContestSlate     @relation(fields: [slateId], references: [id], onDelete: Cascade)
  entryId     String
  entry       ContestEntry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  rank        Int
  amountCents Int
  currency    String           @default("USD")
  status      PrizeAwardStatus @default(DRAFT)
  payout      Payout?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Payout {
  id           String       @id @default(cuid())
  prizeAwardId String       @unique
  prizeAward   PrizeAward   @relation(fields: [prizeAwardId], references: [id], onDelete: Cascade)
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String?
  providerRef  String?
  amountCents  Int
  currency     String       @default("USD")
  status       PayoutStatus @default(PENDING)
  metadata     Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}
